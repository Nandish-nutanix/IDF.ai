flowchart TD
  user["NL query"] --> ground["Schema grounding<br/>(entity + real attributes + few-shot)"]
  ground --> gen["Phi-4 constrained decode<br/>(Outlines &rarr; typed JSON IR)"]
  gen --> validate["Schema-aware validate + repair IR<br/>(snap columns, coerce types, fix ops)"]
  validate --> render["Deterministic IR &rarr; proto text"]
  gen -. "constrained gen error" .-> fallback["Guaranteed minimal IR<br/>from resolved entity + filters"]
  validate -. "irreparable" .-> refine["One targeted Phi-4 self-correct<br/>(errors + correct snippet)"]
  refine --> validate
  fallback --> render
  render --> out["Valid proto + confidence"]
  schema[("schema_service<br/>.template (702 entity types)")] --- ground
  schema --- validate
  emb[("nomic-embed + ChromaDB<br/>few-shot exemplars")] --- ground

  classDef phi fill:#6d28d9,stroke:#4c1d95,color:#fff;
  classDef det fill:#0e7490,stroke:#155e75,color:#fff;
  classDef store fill:#374151,stroke:#1f2937,color:#fff;
  class gen,refine phi;
  class validate,render,fallback det;
  class schema,emb store;
