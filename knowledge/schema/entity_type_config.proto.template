entity_type_info_list {
  entity_type_name : "task"
  type_info {
    track_attribute_changes : false
    suppress_replication : false
    replication_control_list {
      enable_replication_from : kNDFS
    }
    shard_strategy {
      shard_type : kEntityType
      shard_entity_type_name : "task"
    }
    allow_entity_deletion_on_replica: true
    enable_pulsehd_collection: true
    enable_pulsehd_condition: {
      lhs: {
        lhs: {
          comparison_expr: {
            lhs: {
              leaf: {
                column: "component"
              }
            }
            operator: kIN
            rhs: {
              leaf: {
                value: {
                  str_list: {
                    # Add here for frequent tasks.
                    # For frequent task, we do NOT collect kSucceeded state.
                    # For the 'task' entity type, this file is used to specify
                    # properties for on-prem collection. For Xi collection,
                    # please go to override file
                    # $TOP/nusights/go/nusights/collector/plugins/insights_collector/xi_config/entity_type_config_override.proto.template
                    value_list: "Atlas"
                    value_list: "aplos"
                  }
                }
              }
            }
          }
        }
        operator: kAnd
        rhs: {
          comparison_expr: {
            lhs: {
              leaf: {
                column: "status"
              }
            }
            operator: kIN
            rhs: {
              leaf: {
                value: {
                  str_list: {
                    value_list: "kAborted"
                    value_list: "kSuspended"
                    value_list: "kFailed"
                  }
                }
              }
            }
          }
        }
      }
      operator: kOr
      rhs: {
        lhs: {
          comparison_expr: {
            lhs: {
              leaf: {
                column: "component"
              }
            }
            operator: kIN
            rhs: {
              leaf: {
                value: {
                  str_list: {
                    # Add here for infrequent tasks.
                    # For infrequent task, we do collect kSucceeded state.
                    # For frequent task, please add to the section above.
                    # For the 'task' entity type, this file is used to specify
                    # properties for on-prem collection. For Xi collection,
                    # please go to override file
                    # $TOP/nusights/go/nusights/collector/plugins/insights_collector/xi_config/entity_type_config_override.proto.template
