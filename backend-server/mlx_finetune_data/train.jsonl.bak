{"messages": [{"role": "system", "content": "You are an IDF (Insights Data Fabric) query generator. Given a natural language query, output:\n1. The API method name on line 1 as \"API: <MethodName>\"\n2. The protobuf text format query on subsequent lines\n\nValid API names: GetEntitiesWithMetrics, GetEntityTypes, GetMetricTypes, UpdateEntity, DeleteEntity, RegisterEntityTypes, RegisterMetricTypes, UnregisterMetricTypes, BatchGetEntitiesWithMetrics, BatchUpdateEntities, BatchDeleteEntities, GetEntities, GetMetricData, PutMetricData, SpotLightSearch, GetEntitiesTrail, AttachEntity, DetachEntity, GetMasterLocation, Watch, PutEvent"}, {"role": "user", "content": "get VMs where is_cvm equals 0 and check.score between 26 and 76 and vm_name contains PC and power_state = on"}, {"role": "assistant", "content": "API: GetEntitiesWithMetrics\nquery {\n  entity_list { entity_type_name: \"vm\" }\n  where_clause {\n    comparison_expr {\n      lhs {\n        leaf {\n          column: \"is_cvm\"\n        }\n      }\n      operator: kLike\n      rhs {\n        value {\n          int64_value: 0\n        }\n      }\n    }\n  }\n  where_clause {\n    comparison_expr {\n      lhs {\n        leaf {\n          column: \"check.score\"\n        }\n      }\n      operator: kBETWEEN\n      rhs {\n        between_filter {\n          lower_bound {\n            value {\n              int64_value: 26\n            }\n          }\n          upper_bound {\n            value {\n              int64_value: 76\n            }\n          }\n        }\n      }\n    }\n  }\n  where_clause {\n    comparison_expr {\n      lhs {\n        leaf {\n          column: \"vm_name\"\n        }\n      }\n      operator: kCONTAINS\n      rhs {\n        value {\n          string_value: \"PC\"\n        }\n      }\n    }\n  }\n  where_clause {\n    comparison_expr {\n      lhs {\n        leaf {\n          column: \"power_state\"\n        }\n      }\n      operator: kEQ\n      rhs {\n        value {\n          string_value: \"on\"\n        }\n      }\n    }\n  }\n  group_by {\n    raw_columns {\n      column: \"is_cvm\"\n    }\n    raw_columns {\n      column: \"check.score\"\n    }\n    raw_columns {\n      column: \"vm_name\"\n    }\n    raw_columns {\n      column: \"power_state\"\n    }\n    raw_limit { limit: 1000 offset: 0 }\n  }\n  cursor_query_info {\n    is_initial_cursor_query: true\n    batch_size: 1000\n  }\n  query_name: \"cursor_vms\"\n}"}]}
